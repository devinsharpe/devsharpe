# Client Environment
VITE_CLOUDFLARE_SITEKEY=1x00000000000000000000AA

# Server Environment
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=betterauthsecretvalue
CLOUDFLARE_SECRET_KEY=1x0000000000000000000000000000000AA
DATABASE_URL=postgresql://postgres:password@localhost/database
DQC_AUTHORIZE_URL=auth-server.url/application/o/authorize/
DQC_CLIENT_ID=provider_client_id
DQC_CLIENT_SECRET=provider_secret_key
DQC_END_SESSION_URL=auth-server.url/application/o/application_id/end-session/
DQC_TOKEN_URL=auth-server.url/application/o/token/
DQC_USER_INFO_URL=auth-server.url/application/o/userinfo/
# Optional: public origin for absolute links (RSS feed); defaults to BETTER_AUTH_URL
SITE_URL=http://localhost:3000
SITE_TITLE="Devin Sharpe"
SITE_SUBTITLE="Senior Software Engineer & (Amateur) Photographer"

# Media storage: any S3-compatible bucket (keep it private). Set S3_ENDPOINT
# (and usually S3_FORCE_PATH_STYLE=true) for R2, MinIO, B2, etc. Without the
# access key pair, the AWS SDK's default credentials (AWS_* vars, profile,
# instance role) are used. S3_PUBLIC_ENDPOINT is only needed when browsers
# reach the bucket at a different address than this server does.
# (`docker compose up` sets all S3_* and IMGPROXY_* values itself.)
S3_BUCKET=devsharpe-media
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# imgproxy renders media. KEY/SALT must match imgproxy's own IMGPROXY_KEY and
# IMGPROXY_SALT (hex). imgproxy reads s3://{S3_BUCKET}/... (IMGPROXY_USE_S3=true)
# unless IMGPROXY_SOURCE_PREFIX says otherwise.
IMGPROXY_URL=http://localhost:8080
IMGPROXY_KEY=
IMGPROXY_SALT=
IMGPROXY_SOURCE_PREFIX=
